{
    "name": "oci-img-diff-dood",
    "build": {
        "dockerfile": "../Dockerfile",
        "target": "dev",
        "context": ".."
    },
    "features": {
        // Use the 'outside' feature to mount the host socket
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "installDockerBuildx": true
        }
    },
    // This tells VS Code to ignore the ENTRYPOINT 
    // to stay inside the container and code.
    "overrideCommand": true,

    // Mount your host's Docker config so regctl can reuse your logins
    // Note: This is commented out since Docker config was removed to fix credential issues
    // "mounts": [
    //     "source=${localEnv:HOME}/.docker/config.json,target=/root/.docker/config.json,type=bind,consistency=cached"
    // ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "rogalmic.bash-debug",
                "ms-vscode.makefile-tools",
                "bats-core.bats-core",
                "github.vscode-github-actions"
            ]
        }
    },
    // Running as root ensures having permission to access the mounted socket
    "remoteUser": "root"
}